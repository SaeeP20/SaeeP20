import Entry
from Stacks import Stack
from CustomExceptions import BadTypeException, InvalidExpression

class RevPolishCalc:
    
    # Constructor
    def __init__(self):
        self.base_stack = Stack()

    # Returns a true if argument is a valid operator
    def is_operator(op):
        try:
            return op in "+-*/"
        except BadTypeException("Not a valid operator"):
            return False
    
    # Returns true if argument is a valid Float
    def is_numeric(num):
        try:
            return float(num)
        except BadTypeException:
            return False

    # Evaluates the expression in reverse-polish notation (numbers then operators)    
    def evaluate(self, expr):
        tokens = expr.split()
        for token in tokens:
            if self.is_numeric(token):
                new_token = Entry(token)
                self.base_stack.push(new_token)
            elif self.is_operator(token) and self.base_stack.sizeof() != 0:
                num_two = self.base_stack.pop().get_num()
                num_one = self.base_stack.pop().get_num()
                if token == "+":
                    new_token = Entry(num_one + num_two)
                    self.base_stack.push(new_token)
                elif token == "-":
                    new_token = Entry(num_one - num_two)
                    self.base_stack.push(new_token)
                elif token == "*":
                    new_token = Entry(num_one * num_two)
                    self.base_stack.push(new_token)
                elif token == "/":
                    new_token = Entry(num_one / num_two)
                    self.base_stack.push(new_token)
        return self.base_stack.pop().get_num()
    